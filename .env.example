# Copy to .env.local and fill in. NEXT_PUBLIC_* values are baked in at build time: redeploy after changing one on Vercel.

# ── Supabase (required) — dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: daily listing-alert cron (/api/cron/alerts)
SUPABASE_SERVICE_ROLE_KEY=

# ── Email (contact-form notifications, listing alerts). Without it emails aren't sent.
RESEND_API_KEY=
# Authenticates Vercel Cron on /api/cron/alerts
CRON_SECRET=

# ── Display
# MAD → USD rate for price hints
NEXT_PUBLIC_MAD_TO_USD_RATE=0.099
# Seller hero "send by WhatsApp" button — digits only, country code, no "+". Empty = hidden.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ── Analytics & ads — all optional; empty = not loaded, no cookie banner. See docs/analytics.md
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GADS_ID=
NEXT_PUBLIC_GADS_LABEL_SIGN_UP=
NEXT_PUBLIC_GADS_LABEL_LISTING_POSTED=
NEXT_PUBLIC_GADS_LABEL_WHATSAPP_CLICK=
NEXT_PUBLIC_GADS_LABEL_SHOW_NUMBER=
NEXT_PUBLIC_GADS_LABEL_MESSAGE_SENT=
NEXT_PUBLIC_META_PIXEL_ID=
# Cookieless; no consent needed
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
